# =============================================================================
# NADLAN — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
#
# Usage:
#   cp .env.local.example .env.local
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE — Database, Auth, and Storage
# -----------------------------------------------------------------------------
# Project URL: found in Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) key: safe to expose to the browser.
# Used by the client-side Supabase client for all user-scoped queries (RLS enforced).
# Found in: Supabase Dashboard → Settings → API → Project API Keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role key: NEVER expose to the browser — server-side only.
# Used by: Vercel Cron (weekly summary), admin API routes.
# Found in: Supabase Dashboard → Settings → API → Project API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# OPENAI — AI Bot Gatekeeper (GPT-4o)
# -----------------------------------------------------------------------------
# Powers the 3-track Bot Gatekeeper (Rentals / Sales / Roommates).
# Used server-side only via: app/api/bot/route.ts
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...


# -----------------------------------------------------------------------------
# GOOGLE MAPS — Map Display + Freehand Polygon Filtering
# -----------------------------------------------------------------------------
# Required APIs to enable in Google Cloud Console:
#   1. Maps JavaScript API  (Swipe map view, pins)
#   2. Places API           (Address autocomplete on property publish form)
#   3. Geocoding API        (Address → lat/lng for PostGIS POINT storage)
#
# Restrict the key to your Vercel domain in production.
# Get your key at: https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...


# -----------------------------------------------------------------------------
# VERCEL CRON — Weekly Summary Security
# -----------------------------------------------------------------------------
# A secret token used to authenticate calls to /api/weekly-summary.
# The Cron job sends this in the Authorization header; the route validates it.
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret-here
